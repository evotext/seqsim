 "strophes": {
  "I,01": {
   "A": [
    "Sone maerc wat hic di bediede",
    "Ende oec mede di ghebiede",
    "Dats dattu di daertoe sals keren",
    "Te ghode altoes so saltu leren"
   ],
   "B": [
    "Nv merket sone wat jc dy ghebiede",
    "En̄ wat ist dat jc dy bediede",
    "dats dattu dy dair ane sulte kerē",
    "datstu goede sulste eren"
   ],
   "C": [
    "Nu merct sone wat ic ghebiede",
    "En̄ wat es dat ic di bediede",
    "Dats dattu di dʼ ane salt keʼen",
    "Dattu gode salt ēmer eeren"
   ],
   "D": [
    "Nv merct sone wat ic v ghebiede",
    "En̄ wat is dat ic v bediede",
    "Dattu di daer aen sout keren",
    "Dattu gode sout emmer eren"
   ],
   "G": [
    "Nv mercket sone wat ick ghebiede",
    "Ende wat dat is dat ick v bediede",
    "dats dat ghy v daer aen sult keeren",
    "Dat ghi Gode ymmer sult eeren"
   ],
   "H": [
    "NV merckt wat ick dij gebiede",
    "En̄ wat is dat ic dij gebiede",
    "Du selste dij daer sone kerē",
    "Dattu gode sult eerē"
   ],
   "M": [
    "Nv mercke wat ic di ghebiede",
    "En̄ wat es dat ic dy bediede",
    "Dats dattu di daer an sult keeren",
    "Dattu gode emmer sult eeren"
   ],
   "Me": [
    "Nv merke sone[...]",
    "en̄ wat es dat[...]",
    "Dats dattu di da[...]",
    "Dattu gode salt e[...]"
   ],
   "P": [
    "Nu merct sone wattic hu ghebiede",
    "En̄ wat is dattic dy bediede",
    "Dats dattu dʼ ane sult keerē",
    "Dattu gode zult emmer eerē"
   ],
   "R": [
    "Nu mercket soē wat ic v gebiede",
    "En̄ vvat dat is dat ic v bediede.",
    "Dats dattu di daer an sult keren",
    "dattu gode immer sult eeren"
   ],
   "d1": [
    "Nv merct sone wat ick ghebiede",
    "Ende wat dat is dat ick v ghebiede",
    "Dats dat ghy v daer aen sult keeren",
    "Dat ghy Gode ymmer sult eeren."
   ],
